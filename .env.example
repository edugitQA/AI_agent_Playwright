# ===========================================
# Playwright Agent - Configurações de Ambiente
# ===========================================
# Copie este arquivo para .env e configure suas credenciais

# === OpenAI API Configuration ===
# Obtenha sua chave em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Modelo OpenAI a ser usado (opcional)
OPENAI_MODEL=gpt-4o-mini

# === Playwright Configuration ===
# Timeout para ações individuais (em milissegundos)
PLAYWRIGHT_TIMEOUT=30000

# Executar testes em modo headless (true/false)
PLAYWRIGHT_HEADLESS=false

# Timeout para navegação (em milissegundos)
PLAYWRIGHT_NAVIGATION_TIMEOUT=30000

# === Agent Configuration ===
# Nível de log do agente (DEBUG, INFO, WARNING, ERROR)
AGENT_LOG_LEVEL=INFO

# Número máximo de tentativas de auto-correção
AGENT_MAX_RETRIES=3

# Timeout para análise do DOM (em segundos)
AGENT_DOM_ANALYSIS_TIMEOUT=60

# === Application URLs ===
# URL base da aplicação de teste
BASE_URL=http://localhost:5173

# === Debugging Options ===
# Salvar snapshots do DOM para análise (true/false)
SAVE_DOM_SNAPSHOTS=true

# Salvar logs detalhados de healing (true/false)
SAVE_HEALING_LOGS=true

# Diretório para salvar artifacts
ARTIFACTS_DIR=./test-results/artifacts

# === CI/CD Configuration ===
# Configurações para ambiente de CI/CD
CI=false
CI_RETRIES=2
CI_WORKERS=1

# === Experimental Features ===
# Habilitar recursos experimentais (true/false)
ENABLE_EXPERIMENTAL_FEATURES=false

# Cache de seletores (true/false)
ENABLE_SELECTOR_CACHE=true
